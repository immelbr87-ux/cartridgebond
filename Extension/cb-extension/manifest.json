{
  "manifest_version": 3,
  "name": "CartridgeBond \u2014 Resale Value",
  "short_name": "CartridgeBond",
  "description": "See locked resale prices for Nintendo Switch games while you shop. Someone may already be waiting.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.gamestop.com/*"
      ],
      "js": [
        "gamestop.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.gamestop.com/*",
    "https://script.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "welcome.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}